    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.ImdbRenamer</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.ImdbRenamer</RootNamespace>
    <!-- Musi odpowiadać wersji zainstalowanego serwera Jellyfin -->
